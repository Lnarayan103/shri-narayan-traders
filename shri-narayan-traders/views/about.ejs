<%- include('partials/header') %>
<% pageTitle = "About Us" %>

<section style="background:var(--navy-grad);border-bottom:3px solid var(--gold);padding:3.5rem 0;">
  <div class="container text-center text-white fade-up">
    <span class="section-tag text-warning">Our Story</span>
    <h1 class="font-playfair fw-bold mt-1 mb-2">About <%= settings.businessName %></h1>
    <p style="color:rgba(255,255,255,.65);">Built on trust. Driven by quality. Committed to you.</p>
    <nav aria-label="breadcrumb"><ol class="breadcrumb justify-content-center mb-0" style="font-size:13px;"><li class="breadcrumb-item"><a href="/" class="text-warning text-decoration-none">Home</a></li><li class="breadcrumb-item active text-white-50">About Us</li></ol></nav>
  </div>
</section>

<div class="container py-5">
  <div class="row g-5 align-items-center mb-5">
    <div class="col-lg-5 fade-up">
      <!-- Tax & Business Registry Certificate Card -->
      <div class="cert-card-about p-4 border-2 shadow-md position-relative" style="background:#fff; border: 2.5px solid var(--gold); border-radius: 16px; overflow: hidden;">
        <div class="cert-badge-snt">TRUSTED</div>
        <h5 class="fw-bold text-dark mb-2 font-playfair"><i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i> Tax &amp; Business Registry</h5>
        <p class="small text-muted mb-4" style="font-size: 12.5px; line-height: 1.5;">Officially registered under the Government of Bihar and Ministry of Finance, India. Fully tax-compliant.</p>
        
        <div class="table-responsive">
          <table class="table table-sm table-borderless small mb-0" style="font-size: 13px;">
            <tbody>
              <tr>
                <td class="fw-bold text-dark py-1.5" style="width: 45%;">Legal Name</td>
                <td class="text-secondary py-1.5">: Laxmi Narayan</td>
              </tr>
              <tr>
                <td class="fw-bold text-dark py-1.5">Trade Name</td>
                <td class="text-secondary py-1.5">: Shri Narayan Traders</td>
              </tr>
              <tr>
                <td class="fw-bold text-dark py-1.5">GSTIN</td>
                <td class="text-warning fw-bold py-1.5">: 10DJSPN6486H1ZP</td>
              </tr>
              <tr>
                <td class="fw-bold text-dark py-1.5">Center Jurisdiction</td>
                <td class="text-secondary py-1.5">: Commercial Taxes Dept.</td>
              </tr>
              <tr>
                <td class="fw-bold text-dark py-1.5">State Jurisdiction</td>
                <td class="text-secondary py-1.5">: Government of Bihar</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Official Documents & Downloads -->
      <div class="cert-card-about p-4 border-2 shadow-sm position-relative mt-4 fade-up" style="background:#fff; border: 2.5px solid var(--gold); border-radius: 16px; overflow: hidden;">
        <h5 class="fw-bold text-dark mb-2 font-playfair"><i class="fa-solid fa-file-pdf text-danger me-2"></i> Corporate Documents</h5>
        <p class="small text-muted mb-3" style="font-size: 12.5px; line-height: 1.5;">Download our official business registration profiles and certificates below:</p>
        
        <div class="d-flex flex-column gap-2">
          <a href="/documents/corporate-profile.pdf" target="_blank" class="btn btn-outline-dark btn-sm text-start fw-bold py-2 px-3" style="font-size:12.5px; border-color: rgba(0,0,0,0.15); border-radius: 8px;"><i class="fa-solid fa-file-pdf text-danger me-2"></i> Company Profile (PDF)</a>
          <a href="/documents/gst-certificate.pdf" target="_blank" class="btn btn-outline-dark btn-sm text-start fw-bold py-2 px-3" style="font-size:12.5px; border-color: rgba(0,0,0,0.15); border-radius: 8px;"><i class="fa-solid fa-file-pdf text-danger me-2"></i> GST Certificate (PDF)</a>
          <a href="/documents/msme-certificate.pdf" target="_blank" class="btn btn-outline-dark btn-sm text-start fw-bold py-2 px-3" style="font-size:12.5px; border-color: rgba(0,0,0,0.15); border-radius: 8px;"><i class="fa-solid fa-file-pdf text-danger me-2"></i> MSME Udyam Certificate (PDF)</a>
        </div>
      </div>
    </div>
    
    <div class="col-lg-7 fade-up fade-up-d1">
      <span class="section-tag">Who We Are</span>
      <h2 class="font-playfair mt-1 mb-3">Our Legacy &amp; Journey Since 1998</h2>
      <div class="snt-divider mb-3"></div>
      
      <!-- Visual Journey Timeline -->
      <div class="about-timeline my-4">
        <div class="timeline-event">
          <div class="te-marker"></div>
          <div class="te-year">1998</div>
          <div class="te-details">
            <h6>Narayan Furniture Founded</h6>
            <p>Started as a local wooden furniture workshop focusing on premium craftsmanship, timber sourcing, and honest client relationships.</p>
          </div>
        </div>
        <div class="timeline-event">
          <div class="te-marker"></div>
          <div class="te-year">2015</div>
          <div class="te-details">
            <h6>Aluminium Fabrication Works</h6>
            <p>Expanded services into architectural aluminium doors, sliding windows, and partition panels, servicing local builders and offices.</p>
          </div>
        </div>
        <div class="timeline-event">
          <div class="te-marker"></div>
          <div class="te-year">2025-26</div>
          <div class="te-details">
            <h6>Shri Narayan Traders Expansion</h6>
            <p>Officially registered as a multi-tier hardware supplier, dealer hub, and custom manufacturing facility at Kaura Maidan, Munger.</p>
          </div>
        </div>
      </div>
      
      <!-- Quality Guarantee Alert -->
      <div class="p-3 rounded border border-warning border-opacity-35 mt-4" style="background: var(--cream); border-left: 5px solid var(--gold) !important; border-radius: 12px !important;">
        <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-square-check text-warning me-2"></i> 100% Furniture Quality Guarantee &amp; Transparency</h6>
        <p class="small text-muted mb-0" style="font-size:12.5px; line-height: 1.6;">
          Aapki santushti humari priority hai! Kisi bhi custom furniture fabrication se pehle, hum humare clients ko <strong>wo saare raw materials (wood quality, ply sheets, fittings, and finishes) physically dikhate aur verify karwate hain</strong> jo unke order mein use hone wale hain. Iss transparent approach ke sath hum 100% quality guarantee pradan karte hain.
        </p>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="stats-row fade-up">
    <% [['500+','Products in Stock'],['5000+','Happy Customers'],['28+','Years Legacy'],['50+','Brands Available']].forEach(([n,l])=>{ %>
    <div class="stat-item"><div class="stat-big"><%= n %></div><div class="stat-lbl"><%= l %></div></div>
    <% }) %>
  </div>

  <!-- Values -->
  <div class="text-center my-5 fade-up">
    <span class="section-tag">What Drives Us</span>
    <h2 class="font-playfair mt-1">Our Core Values</h2>
    <div class="snt-divider mx-auto mt-2"></div>
  </div>
  <div class="row g-3 mb-5">
    <% [
      {n:'01',ic:'fa-trophy',t:'Quality First',d:'Every product is carefully sourced and quality checked before it reaches you. We never compromise on standards.'},
      {n:'02',ic:'fa-indian-rupee-sign',t:'Honest Pricing',d:'Transparent pricing, no hidden charges. Regular offers ensure you always get the best value for your money.'},
      {n:'03',ic:'fa-heart',t:'Customer Care',d:'Your satisfaction is our goal. We go the extra mile to ensure every customer leaves confident and happy.'},
      {n:'04',ic:'fa-seedling',t:'Community Focus',d:'Proud to serve our local community. We support local builders, contractors and households with the best products.'}
    ].forEach(v=>{ %>
    <div class="col-md-3 col-6 fade-up">
      <div class="value-card-about">
        <div class="vc-num"><%= v.n %></div>
        <div class="vc-icon"><i class="fa-solid <%= v.ic %>"></i></div>
        <h6><%= v.t %></h6>
        <p><%= v.d %></p>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<!-- CTA -->
<section class="py-5" style="background:var(--gold-grad);">
  <div class="container text-center fade-up">
    <h2 class="font-playfair fw-bold mb-2" style="color:var(--navy-deep);">Visit Our Store Today</h2>
    <p style="color:rgba(0,15,43,.65);font-size:15px;" class="mb-4">Our team is ready to help you find exactly what you need.</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
      <a href="/contact" class="btn fw-bold px-4 py-2" style="background:var(--navy-deep);color:#fff;border-radius:30px;"><i class="fa-solid fa-location-dot me-2"></i>Get Directions</a>
      <a href="/products" class="btn fw-bold px-4 py-2" style="background:rgba(0,15,43,.15);color:var(--navy-deep);border:2px solid var(--navy-deep);border-radius:30px;"><i class="fa-solid fa-boxes-stacked me-2"></i>Browse Products</a>
    </div>
  </div>
</section>

<style>
.about-visual-box { background:linear-gradient(135deg,var(--navy) 0%,var(--navy-deep) 100%);border-radius:20px;border:2px solid rgba(201,146,42,.2);aspect-ratio:1;max-width:420px;margin:0 auto;display:flex;align-items:center;justify-content:center;position:relative;overflow:visible; }
.av-center { text-align:center; }
.av-badge { position:absolute;background:rgba(0,15,43,.9);backdrop-filter:blur(8px);border:1px solid rgba(201,146,42,.3);color:#fff;padding:8px 14px;border-radius:30px;font-size:12px;font-weight:600;white-space:nowrap;animation:floatB 3s ease-in-out infinite; }
@keyframes floatB{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.about-pill { background:rgba(0,31,77,.06);border:1.5px solid rgba(0,31,77,.1);border-radius:8px;padding:8px 14px;font-size:13px;font-weight:600;color:var(--navy);display:flex;align-items:center; }
.stats-row { display:flex;gap:0;border-radius:16px;overflow:hidden;box-shadow:var(--shadow-md);margin-bottom:3rem; }
.stat-item { flex:1;text-align:center;padding:2rem 1rem;background:#fff;border-right:1px solid rgba(201,146,42,.12); }
.stat-item:last-child { border-right:none; }
.stat-big { font-family:'Playfair Display',serif;font-size:2.2rem;font-weight:800;color:var(--gold-dark);line-height:1; }
.stat-lbl { font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.07em;margin-top:.3rem;font-weight:600; }
.value-card-about { background:#fff;border-radius:14px;padding:1.75rem 1.5rem;height:100%;border:1px solid rgba(201,146,42,.1);box-shadow:var(--shadow-sm);position:relative;transition:all .25s ease; }
.value-card-about:hover { box-shadow:var(--shadow-md);border-color:rgba(201,146,42,.3); }
.vc-num { position:absolute;top:.75rem;right:1rem;font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:800;color:rgba(201,146,42,.1);line-height:1; }
.vc-icon { width:44px;height:44px;background:rgba(201,146,42,.12);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:1.1rem;margin-bottom:.85rem; }
.value-card-about h6 { font-weight:700;color:var(--navy);margin-bottom:.4rem; }
.value-card-about p  { font-size:13px;color:var(--text-muted);line-height:1.75;margin:0; }
.stat-lbl { font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.07em;margin-top:.3rem;font-weight:600; }
.value-card-about { background:#fff;border-radius:14px;padding:1.75rem 1.5rem;height:100%;border:1px solid rgba(201,146,42,.1);box-shadow:var(--shadow-sm);position:relative;transition:all var(--dur) var(--ease); }
.value-card-about:hover { box-shadow:var(--shadow-md);border-color:rgba(201,146,42,.3); transform: translateY(-3px); }
.vc-num { position:absolute;top:.75rem;right:1rem;font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:800;color:rgba(201,146,42,.1);line-height:1; }
.vc-icon { width:44px;height:44px;background:rgba(201,146,42,.12);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:1.1rem;margin-bottom:.85rem; }
.value-card-about h6 { font-weight:700;color:var(--navy);margin-bottom:.4rem; }
.value-card-about p  { font-size:13px;color:var(--text-muted);line-height:1.75;margin:0; }

/* Timeline & Certificate Specifics */
.cert-card-about {
  box-shadow: 0 15px 35px rgba(0, 31, 77, 0.06);
  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}
.cert-card-about:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 45px rgba(0, 31, 77, 0.12);
}
.cert-badge-snt {
  position: absolute;
  top: 14px; right: -28px;
  background: var(--gold-grad);
  color: var(--navy-deep);
  font-weight: 800; font-size: 8px;
  padding: 4px 28px;
  transform: rotate(45deg);
  letter-spacing: 1px;
}
.about-timeline {
  position: relative;
  padding-left: 30px;
  border-left: 2px dashed rgba(201,146,42,0.3);
  display: flex;
  flex-direction: column;
  gap: 22px;
}
.timeline-event {
  position: relative;
}
.te-marker {
  position: absolute;
  left: -41px; top: 4px;
  width: 20px; height: 20px;
  border-radius: 50%;
  background: var(--gold-grad);
  border: 4px solid var(--cream); /* Matches soft warm cream backdrop */
  box-shadow: 0 0 10px rgba(201,146,42,0.35);
  transition: transform var(--dur) var(--ease);
}
.timeline-event:hover .te-marker {
  transform: scale(1.25);
}
.te-year {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem; font-weight: 800;
  color: var(--gold-dark);
  margin-bottom: 2px;
}
.te-details h6 {
  font-weight: 700; color: var(--navy);
  margin-bottom: 4px;
  font-size: 14.5px;
}
.te-details p {
  font-size: 13.5px; color: var(--text-muted);
  line-height: 1.6; margin: 0;
}
@media(max-width:576px){.stats-row{flex-wrap:wrap;}.stat-item{flex:1 1 50%;border-right:1px solid rgba(201,146,42,.12)!important;border-bottom:1px solid rgba(201,146,42,.12);}}
</style>

<%- include('partials/footer') %>
