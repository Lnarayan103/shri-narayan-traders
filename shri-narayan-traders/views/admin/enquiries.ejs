<%- include('../partials/admin-header') %>
<% pageTitle = "Enquiries" %>

<div class="admin-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="font-playfair mb-0">Customer Enquiries</h4>
      <p class="text-muted mb-0" style="font-size:13px"><%= enquiries ? enquiries.filter(e=>e.status==='new').length : 0 %> unread enquiries</p>
    </div>
  </div>

  <div class="status-tabs mb-3">
    <% ['all','new','in-progress','resolved'].forEach(s=>{ %>
    <button class="status-tab <%=s==='all'?'active':''%>" onclick="filterEnq(this,'<%= s %>')"><%= s.charAt(0).toUpperCase()+s.slice(1) %></button>
    <% }) %>
  </div>

  <div class="admin-card">
    <div class="table-responsive">
      <table class="admin-table" id="enqTable">
        <thead><tr><th>Name</th><th>Phone</th><th>Subject</th><th>Message</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead>
        <tbody>
          <% if(enquiries && enquiries.length > 0) { %>
          <% enquiries.forEach(enq=>{ %>
          <tr data-status="<%= enq.status||'new' %>" style="<%= enq.status==='new'?'font-weight:600;background:rgba(201,146,42,.03);':'' %>">
            <td>
              <div style="font-weight:700;font-size:13.5px;"><%= enq.name %></div>
              <% if(enq.email){ %><div style="font-size:11px;color:var(--text-muted);"><%= enq.email %></div><% } %>
            </td>
            <td><a href="tel:<%= enq.phone %>" style="font-size:13px;font-weight:600;color:var(--navy);text-decoration:none;"><%= enq.phone %></a></td>
            <td><span style="font-size:12.5px;"><%= enq.subject||'General' %></span></td>
            <td style="max-width:220px;"><p style="font-size:12.5px;color:var(--text-muted);margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= enq.message %>"><%= enq.message %></p></td>
            <td>
              <select class="form-control-admin" style="padding:4px 8px;font-size:12px;min-width:120px;" onchange="updateEnqStatus('<%= enq._id %>',this.value)">
                <% ['new','in-progress','resolved'].forEach(s=>{ %>
                <option value="<%= s %>" <%=(enq.status||'new')===s?'selected':''%>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option>
                <% }) %>
              </select>
            </td>
            <td style="font-size:12px;white-space:nowrap;"><%= new Date(enq.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></td>
            <td>
              <div style="display:flex;gap:.35rem;">
                <a href="tel:<%= enq.phone %>" class="btn-admin-xs" title="Call"><i class="fa-solid fa-phone"></i></a>
                <a href="https://wa.me/<%= enq.phone.replace(/[^0-9]/g,'') %>?text=Hello%20<%= encodeURIComponent(enq.name) %>,%20regarding%20your%20enquiry..." target="_blank" class="btn-admin-xs" title="WhatsApp" style="background:rgba(37,211,102,.1);color:#16a34a;border-color:rgba(37,211,102,.2);"><i class="fa-brands fa-whatsapp"></i></a>
                <button onclick="deleteEnq('<%= enq._id %>',this)" class="btn-admin-xs" style="background:rgba(220,38,38,.08);color:#dc2626;border-color:rgba(220,38,38,.15);"><i class="fa-solid fa-trash"></i></button>
              </div>
            </td>
          </tr>
          <% }) %>
          <% } else { %>
          <tr><td colspan="7" class="text-center py-5 text-muted"><i class="fa-solid fa-inbox fa-3x mb-3 d-block" style="color:rgba(201,146,42,.2)"></i>No enquiries yet</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
.status-tabs{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1rem;}
.status-tab{background:#fff;border:1.5px solid rgba(0,0,0,.1);border-radius:8px;padding:6px 14px;font-size:12.5px;font-weight:600;cursor:pointer;color:var(--text-muted);transition:all .2s ease;}
.status-tab.active,.status-tab:hover{background:var(--navy-grad);color:#fff;border-color:transparent;}
</style>

<script>
function filterEnq(btn, status){
  document.querySelectorAll('.status-tab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('#enqTable tbody tr[data-status]').forEach(row=>{
    row.style.display = status==='all'||row.dataset.status===status?'':'none';
  });
}
async function updateEnqStatus(id, status){
  const res = await fetch(`/api/enquiries/${id}/status`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status})});
  if(res.ok) adminToast('Status updated','success');
  else adminToast('Failed','error');
}
async function deleteEnq(id, btn){
  if(!confirm('Delete this enquiry?')) return;
  const res = await fetch(`/api/enquiries/${id}`,{method:'DELETE'});
  if(res.ok){ btn.closest('tr').remove(); adminToast('Enquiry deleted','success'); }
}
</script>

<%- include('../partials/admin-footer') %>
