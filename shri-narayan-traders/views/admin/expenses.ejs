<%- include('../partials/admin-header') %>
<div class="admin-content">
  <div class="d-flex justify-content-between mb-4"><h4 class="mb-0">Expenses</h4>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#exModal">+ Add Expense</button></div>
  <div class="admin-card table-responsive"><table class="table table-hover mb-0">
    <thead class="table-light"><tr><th>Date</th><th>Category</th><th>Amount</th><th>Mode</th><th>Description</th><th></th></tr></thead>
    <tbody>
      <% (expenses||[]).forEach(e => { %>
      <tr><td class="small"><%= e.date||'—' %></td><td class="fw-bold"><%= e.category %></td>
        <td style="color:#ef4444;font-weight:700;">₹<%= (e.amount||0).toLocaleString('en-IN') %></td>
        <td><%= e.paymentMode||'cash' %></td><td class="small"><%= e.description||'' %></td>
        <td><button class="btn btn-sm btn-outline-danger" onclick="del('/api/expenses/<%= e._id %>')">Del</button></td></tr>
      <% }) %>
      <% if(!(expenses||[]).length){ %><tr><td colspan="6" class="text-center text-muted py-4">No expenses</td></tr><% } %>
    </tbody></table></div>
</div>
<div class="modal fade" id="exModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">Add Expense</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <select id="eCat" class="form-select mb-2">
      <option>Rent</option><option>Electricity</option><option>Transport</option><option>Salary</option>
      <option>Raw Material</option><option>Marketing</option><option>Maintenance</option><option>Other</option>
    </select>
    <input id="eAmt" type="number" class="form-control mb-2" placeholder="Amount *">
    <input id="eDate" type="date" class="form-control mb-2">
    <select id="eMode" class="form-select mb-2"><option>cash</option><option>upi</option><option>bank</option></select>
    <input id="eDesc" class="form-control" placeholder="Description">
  </div>
  <div class="modal-footer"><button class="btn btn-primary" onclick="saveEx()">Save</button></div>
</div></div></div>
<script>
async function saveEx(){
  const body={category:eCat.value,amount:+eAmt.value,date:eDate.value,paymentMode:eMode.value,description:eDesc.value};
  const r=await fetch('/api/expenses',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  if(r.ok) location.reload(); else alert('Failed');
}
async function del(url){ if(confirm('Delete?')){ await fetch(url,{method:'DELETE'}); location.reload(); }}
</script>
<%- include('../partials/admin-footer') %>
