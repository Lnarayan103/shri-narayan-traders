<%- include('../partials/admin-header') %>
<% pageTitle = "Products" %>

<div class="admin-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="font-playfair mb-0">Products</h4>
      <p class="text-muted mb-0" style="font-size:13px">Manage your product catalog</p>
    </div>
    <a href="/admin/products/add" class="btn-admin-primary"><i class="fa-solid fa-plus"></i> Add Product</a>
  </div>

  <!-- Filters -->
  <div class="admin-card mb-3">
    <div style="padding:1rem 1.25rem;display:flex;gap:.75rem;flex-wrap:wrap;align-items:center;">
      <input type="text" id="searchInput" class="form-control-admin" placeholder="🔍 Search products..." style="max-width:260px;" oninput="filterProducts()"/>
      <select id="catFilter" class="form-control-admin" style="max-width:180px;" onchange="filterProducts()">
        <option value="">All Categories</option>
        <option>Hardware</option><option>Furniture</option><option>Office</option>
        <option>Doors</option><option>Windows</option><option>Tools</option>
      </select>
      <select id="stockFilter" class="form-control-admin" style="max-width:160px;" onchange="filterProducts()">
        <option value="">All Stock</option>
        <option value="instock">In Stock</option>
        <option value="low">Low Stock</option>
        <option value="out">Out of Stock</option>
      </select>
    </div>
  </div>

  <div class="admin-card">
    <div class="table-responsive">
      <table class="admin-table" id="productsTable">
        <thead>
          <tr>
            <th style="width:50px">#</th>
            <th>Product</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Featured</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(products && products.length > 0) { %>
          <% products.forEach((p, i) => { %>
          <tr data-name="<%= p.name.toLowerCase() %>" data-cat="<%= p.category %>" data-stock="<%= p.stock<=0?'out':(p.stock<=5?'low':'instock') %>">
            <td style="color:var(--text-muted);font-size:12px;"><%= i+1 %></td>
            <td>
              <div style="display:flex;align-items:center;gap:.75rem;">
                <div style="width:42px;height:42px;background:var(--cream);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0;border:1px solid rgba(0,0,0,.06);">
                  <% if(p.image || p.imageUrl) { %><img src="<%= p.image || p.imageUrl %>" style="width:100%;height:100%;object-fit:cover;border-radius:9px;" /><% } else { %>📦<% } %>
                </div>
                <div>
                  <div style="font-weight:700;font-size:13.5px;color:var(--navy);"><%= p.name %></div>
                  <div style="font-size:11px;color:var(--text-muted);">ID: <%= p._id %></div>
                </div>
              </div>
            </td>
            <td><span class="status-badge" style="background:rgba(201,146,42,.1);color:var(--gold-dark);border:1px solid rgba(201,146,42,.2);"><%= p.category %></span></td>
            <td>
              <div style="font-weight:700;color:var(--navy);">₹<%= p.price.toLocaleString('en-IN') %></div>
              <% if(p.originalPrice) { %><div style="font-size:11px;color:var(--text-muted);text-decoration:line-through;">₹<%= p.originalPrice.toLocaleString('en-IN') %></div><% } %>
            </td>
            <td>
              <% if(p.stock <= 0) { %>
                <span class="status-badge status-cancelled">Out of Stock</span>
              <% } else if(p.stock <= 5) { %>
                <span class="status-badge status-pending"><%= p.stock %> left ⚠️</span>
              <% } else { %>
                <span class="status-badge status-delivered"><%= p.stock %> units</span>
              <% } %>
            </td>
            <td>
              <button onclick="toggleFeatured('<%= p._id %>', this)" class="toggle-switch <%= p.featured ? 'on' : '' %>">
                <span></span>
              </button>
            </td>
            <td>
              <div style="display:flex;gap:.4rem;">
                <a href="/admin/products/edit/<%= p._id %>" class="btn-admin-xs"><i class="fa-solid fa-pen"></i></a>
                <button onclick="deleteProduct('<%= p._id %>', this)" class="btn-admin-xs" style="background:rgba(220,38,38,.08);color:#dc2626;border:1px solid rgba(220,38,38,.15);"><i class="fa-solid fa-trash"></i></button>
              </div>
            </td>
          </tr>
          <% }) %>
          <% } else { %>
          <tr><td colspan="7" class="text-center py-5">
            <i class="fa-solid fa-boxes-stacked fa-3x mb-3 d-block" style="color:rgba(201,146,42,.2)"></i>
            <p class="text-muted mb-2">No products yet.</p>
            <a href="/admin/products/add" class="btn-admin-primary">Add First Product</a>
          </td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
.toggle-switch { width:42px;height:24px;background:#e2e8f0;border-radius:12px;border:none;cursor:pointer;position:relative;transition:background .25s ease;flex-shrink:0; }
.toggle-switch span { position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;transition:transform .25s ease;box-shadow:0 1px 4px rgba(0,0,0,.2); }
.toggle-switch.on { background:var(--gold); }
.toggle-switch.on span { transform:translateX(18px); }
</style>

<script>
function filterProducts() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const cat = document.getElementById('catFilter').value;
  const stock = document.getElementById('stockFilter').value;
  document.querySelectorAll('#productsTable tbody tr[data-name]').forEach(row => {
    const matchQ = !q || row.dataset.name.includes(q);
    const matchC = !cat || (() => {
      const dbCat = (row.dataset.cat || '').trim().toLowerCase();
      const filterCat = cat.trim().toLowerCase();
      return dbCat === filterCat || dbCat.includes(filterCat) || filterCat.includes(dbCat);
    })();
    const matchS = !stock || row.dataset.stock === stock;
    row.style.display = (matchQ && matchC && matchS) ? '' : 'none';
  });
}
async function toggleFeatured(id, btn) {
  btn.classList.toggle('on');
  await fetch(`/api/products/${id}/featured`, { method: 'PATCH' });
  adminToast('Featured status updated', 'success');
}
async function deleteProduct(id, btn) {
  if (!confirm('Delete this product? This cannot be undone.')) return;
  const res = await fetch(`/api/products/${id}`, { method: 'DELETE' });
  if (res.ok) { btn.closest('tr').remove(); adminToast('Product deleted', 'success'); }
  else adminToast('Failed to delete', 'error');
}
</script>

<%- include('../partials/admin-footer') %>
