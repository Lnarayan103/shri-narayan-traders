<%- include('../partials/header') %>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold font-playfair text-dark mb-0">Manage Customer Reviews</h1>
      <p class="text-secondary small">Approve or reject customer reviews before they display on the public homepage</p>
    </div>
    <div>
      <a href="/admin/dashboard" class="btn btn-outline-dark fw-bold"><i class="fa-solid fa-arrow-left"></i> Dashboard</a>
    </div>
  </div>

  <div class="bg-white p-4 rounded shadow-sm border">
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th>Date</th>
            <th>Customer Name</th>
            <th>Rating</th>
            <th>Review Message</th>
            <th class="text-center">Status</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (reviews && reviews.length > 0) { %>
            <% reviews.forEach(rev => { %>
              <tr id="row-<%= rev._id %>">
                <td><%= new Date(rev.createdAt).toLocaleDateString() %></td>
                <td><strong class="text-dark"><%= rev.name %></strong></td>
                <td>
                  <div class="text-warning">
                    <% for(let i=1; i<=5; i++) { %>
                      <i class="<%= i <= rev.rating ? 'fa-solid' : 'fa-regular' %> fa-star"></i>
                    <% } %>
                  </div>
                </td>
                <td><span class="text-secondary small"><%= rev.message %></span></td>
                <td class="text-center">
                  <% if (rev.approved) { %>
                    <span class="badge bg-success-subtle text-success border border-success"><i class="fa-solid fa-circle-check me-1"></i> Publicly Visible</span>
                  <% } else { %>
                    <span class="badge bg-warning-subtle text-warning border border-warning"><i class="fa-solid fa-hourglass-half me-1"></i> Pending Approval</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <% if (!rev.approved) { %>
                    <button class="btn btn-success btn-sm fw-bold me-1" onclick="updateReviewStatus('<%= rev._id %>', true)"><i class="fa-solid fa-circle-check"></i> Approve</button>
                  <% } else { %>
                    <button class="btn btn-warning btn-sm fw-bold me-1" onclick="updateReviewStatus('<%= rev._id %>', false)"><i class="fa-solid fa-circle-xmark"></i> Hide</button>
                  <% } %>
                  <button class="btn btn-outline-danger btn-sm" onclick="deleteReview('<%= rev._id %>')" title="Delete"><i class="fa-solid fa-trash-can"></i></button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">No reviews found in database. Reviews can be submitted from the homepage feedback form.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  async function updateReviewStatus(id, approved) {
    try {
      const response = await fetch(`/api/reviews/${id}/approve`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approved })
      });
      const result = await response.json();
      
      if (response.ok) {
        alert(result.message || 'Review status updated.');
        window.location.reload();
      } else {
        alert(result.error || 'Failed to update review status.');
      }
    } catch(err) {
      alert('Network error updating status.');
    }
  }

  async function deleteReview(id) {
    if(!confirm('Permanently delete this customer review?')) return;
    try {
      const response = await fetch(`/api/reviews/${id}`, { method: 'DELETE' });
      if (response.ok) {
        alert('Review deleted.');
        document.getElementById(`row-${id}`).remove();
      } else {
        alert('Failed to delete review.');
      }
    } catch(err) {
      alert('Network error while deleting.');
    }
  }
</script>

<%- include('../partials/footer') %>
