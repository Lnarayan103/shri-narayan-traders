<%- include('../partials/admin-header') %>
<% pageTitle = "Staff Roles" %>

<div class="admin-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="font-playfair mb-0">Role & Staff Permissions</h4>
      <p class="text-muted mb-0" style="font-size:13px">Define team authorization scopes: Super Admin, Manager, and Sales Staff</p>
    </div>
    <div>
      <button class="btn btn-primary fw-bold btn-sm" data-bs-toggle="modal" data-bs-target="#addStaffModal"><i class="fa-solid fa-user-plus me-1"></i> Add Staff</button>
    </div>
  </div>

  <div class="row g-4">
    <!-- Permissions Explanation Sidebar -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm bg-dark text-white p-4 h-100 border-start border-warning border-4">
        <h5 class="text-warning fw-bold mb-4 font-playfair"><i class="fa-solid fa-shield-halved me-1"></i> Authorization Matrix</h5>
        
        <div class="mb-3">
          <strong class="text-warning small d-block">👑 Super Admin / Admin</strong>
          <p class="text-secondary small mb-0">Complete read/write permissions. Access to billing, database backup downloads, restore modules, logs, settings, and staff role allocations.</p>
        </div>
        <hr class="border-secondary my-3">
        <div class="mb-3">
          <strong class="text-info small d-block">💼 Manager</strong>
          <p class="text-secondary small mb-0">Catalog inventory CRUD, gallery additions, customer review approvals, pending dealer verifications, and order processing. Blocked from backups, security logs, and settings.</p>
        </div>
        <hr class="border-secondary my-3">
        <div>
          <strong class="text-success small d-block">💵 Sales Staff</strong>
          <p class="text-secondary small mb-0">POS GST billing system access, invoice generation, viewing dashboard statistics, and looking up order statuses. Blocked from catalog changes, dealer settings, and promos.</p>
        </div>
      </div>
    </div>

    <!-- Staff List Column -->
    <div class="col-lg-8">
      <div class="bg-white p-4 rounded shadow-sm border h-100">
        <div class="table-responsive">
          <table class="table table-striped align-middle">
            <thead>
              <tr>
                <th>Team Member</th>
                <th>Phone / Contact</th>
                <th>Role Badge</th>
                <th class="text-center">Action</th>
              </tr>
            </thead>
            <tbody id="staffBody">
              <tr>
                <td colspan="4" class="text-center py-5 text-muted">
                  <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                  Fetching authorization roster...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Staff Modal -->
<div class="modal fade" id="addStaffModal" tabindex="-1" aria-labelledby="addStaffModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-dark text-white border-bottom border-warning border-3">
        <h5 class="modal-title font-playfair fw-bold" id="addStaffModalLabel">Add Staff Member</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="addStaffForm">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Username</label>
            <input type="text" class="form-control" name="username" required placeholder="e.g. rajesh_sales">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Email Address</label>
            <input type="email" class="form-control" name="email" required placeholder="e.g. rajesh@shri-narayan.com">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Temporary Password</label>
            <input type="password" class="form-control" name="password" required placeholder="Minimum 6 characters">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Staff Role Profile</label>
            <select class="form-select" name="role" required>
              <option value="sales" selected>Sales Staff (Billing & POS only)</option>
              <option value="manager">Manager (Inventory, Offers, Gallery, Reviews)</option>
              <option value="admin">Admin (All authorizations)</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Phone Number</label>
            <input type="text" class="form-control" name="phone" placeholder="10-digit number">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Official Business Identifier</label>
            <input type="text" class="form-control" name="businessName" placeholder="e.g. SNT Sales Counter">
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary fw-bold">Register Staff</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    fetchStaff();
    document.getElementById('addStaffForm').addEventListener('submit', handleAddStaff);
  });

  async function fetchStaff() {
    const tbody = document.getElementById('staffBody');
    try {
      const response = await fetch('/api/system/staff');
      const staffList = await response.json();
      
      if (!response.ok) {
        tbody.innerHTML = `<tr><td colspan="4" class="text-danger text-center py-4">Error: ${staffList.error || 'Failed loading staff'}</td></tr>`;
        return;
      }
      
      let html = '';
      staffList.forEach(s => {
        let badgeClass = 'bg-secondary';
        if (s.role === 'admin' || s.role === 'super-admin') badgeClass = 'bg-warning text-dark';
        else if (s.role === 'manager') badgeClass = 'bg-info text-dark';
        else if (s.role === 'sales') badgeClass = 'bg-success';
        
        const isSelf = s._id === '<%= locals.user ? user.id : "" %>';
        
        html += `
          <tr>
            <td>
              <strong class="text-dark d-block">${s.username}</strong>
              <small class="text-muted">${s.email}</small>
            </td>
            <td>
              <span class="d-block small"><i class="fa-solid fa-phone text-muted me-1"></i> ${s.phone || 'N/A'}</span>
              <span class="d-block text-muted" style="font-size: 10px;">${s.businessName || 'SNT Staff'}</span>
            </td>
            <td>
              <span class="badge ${badgeClass} text-uppercase px-2 py-1">${s.role}</span>
            </td>
            <td class="text-center">
              ${isSelf ? '<span class="badge bg-secondary">Current User</span>' : `
                <button class="btn btn-outline-danger btn-sm p-1 py-0" onclick="deleteStaff('${s._id}', '${s.username}')" title="Remove Member">
                  <i class="fa-solid fa-trash-can"></i>
                </button>
              `}
            </td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    } catch (err) {
      tbody.innerHTML = `<tr><td colspan="4" class="text-danger text-center py-4">Network error loading team members.</td></tr>`;
    }
  }

  async function handleAddStaff(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    
    // Parse form values
    const data = {};
    formData.forEach((value, key) => data[key] = value);
    
    try {
      const response = await fetch('/api/system/staff', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      const result = await response.json();
      if (response.ok) {
        alert(result.message || 'Staff registered successfully!');
        form.reset();
        
        // Hide modal
        const modalEl = document.getElementById('addStaffModal');
        const modalInstance = bootstrap.Modal.getInstance(modalEl);
        modalInstance.hide();
        
        fetchStaff();
      } else {
        alert(result.error || 'Failed to register staff.');
      }
    } catch(err) {
      alert('Error connecting to backend API.');
    }
  }

  async function deleteStaff(id, name) {
    if(!confirm(`Are you absolutely sure you want to delete staff account: "${name}"?`)) return;
    try {
      const response = await fetch(`/api/system/staff/${id}`, { method: 'DELETE' });
      const result = await response.json();
      if (response.ok) {
        alert(result.message || 'Staff removed successfully.');
        fetchStaff();
      } else {
        alert(result.error || 'Failed to remove staff.');
      }
    } catch(err) {
      alert('Error deleting staff.');
    }
  }
</script>

<%- include('../partials/admin-footer') %>
