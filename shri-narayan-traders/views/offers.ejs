<%- include('partials/header') %>
<% pageTitle = "Current Offers & Deals" %>
<% const offers = locals.activeOffers || locals.offers || []; %>

<section style="background:var(--navy-grad);border-bottom:3px solid var(--gold);padding:3.5rem 0;">
  <div class="container text-center text-white fade-up">
    <span class="section-tag text-warning"><i class="fa-solid fa-fire me-1"></i> Hot Deals</span>
    <h1 class="font-playfair fw-bold mt-1 mb-2">Current Offers &amp; Deals</h1>
    <p style="color:rgba(255,255,255,.65);">Grab the best deals before they expire!</p>
    <nav aria-label="breadcrumb"><ol class="breadcrumb justify-content-center mb-0" style="font-size:13px;"><li class="breadcrumb-item"><a href="/" class="text-warning text-decoration-none">Home</a></li><li class="breadcrumb-item active text-white-50">Offers</li></ol></nav>
  </div>
</section>

<div class="container py-5">
  <!-- Countdown Timer Container -->
  <% if (locals.countdownTarget) { %>
    <div class="row justify-content-center mb-5 fade-up">
      <div class="col-lg-8">
        <div class="card text-white text-center p-4 border-2 shadow-sm rounded-3" style="background: linear-gradient(135deg, var(--navy-deep) 0%, #001533 100%); border: 2px solid var(--gold) !important;">
          <h5 class="text-warning text-uppercase fw-bold mb-3" style="letter-spacing: 1.5px; font-size: 13.5px;"><i class="fa-solid fa-bolt me-1 text-danger"></i> Flash Deals Ending In <i class="fa-solid fa-bolt ms-1 text-danger"></i></h5>
          
          <div class="d-flex justify-content-center align-items-center gap-3 my-2 flex-wrap">
            <div class="text-center p-2 rounded" style="background: rgba(255,255,255,0.04); min-width: 70px; border: 1px solid rgba(255,255,255,0.07);">
              <span id="timer-days" class="d-block fw-bold font-playfair fs-2 text-warning">00</span>
              <small class="text-uppercase text-white-50" style="font-size: 10px; letter-spacing: 0.5px;">Days</small>
            </div>
            <div class="text-center p-2 rounded" style="background: rgba(255,255,255,0.04); min-width: 70px; border: 1px solid rgba(255,255,255,0.07);">
              <span id="timer-hours" class="d-block fw-bold font-playfair fs-2 text-warning">00</span>
              <small class="text-uppercase text-white-50" style="font-size: 10px; letter-spacing: 0.5px;">Hrs</small>
            </div>
            <div class="text-center p-2 rounded" style="background: rgba(255,255,255,0.04); min-width: 70px; border: 1px solid rgba(255,255,255,0.07);">
              <span id="timer-minutes" class="d-block fw-bold font-playfair fs-2 text-warning">00</span>
              <small class="text-uppercase text-white-50" style="font-size: 10px; letter-spacing: 0.5px;">Mins</small>
            </div>
            <div class="text-center p-2 rounded" style="background: rgba(255,255,255,0.04); min-width: 70px; border: 1px solid rgba(255,255,255,0.07);">
              <span id="timer-seconds" class="d-block fw-bold font-playfair fs-2 text-warning">00</span>
              <small class="text-uppercase text-white-50" style="font-size: 10px; letter-spacing: 0.5px;">Secs</small>
            </div>
          </div>
          <p class="small text-white-50 mb-0 mt-3">Hurry up! Avail bulk dealer benefits before the pricing schedules reset.</p>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Active Offers List -->
  <% if(offers && offers.length > 0) { %>
  <div class="row g-4 mb-5">
    <% offers.forEach((offer, i) => { %>
    <div class="col-lg-4 col-md-6 fade-up" style="animation-delay:<%=i*0.08%>s">
      <div class="offer-card-full">
        <div class="ocf-header">
          <span class="ocf-tag"><%= offer.tag || 'Special Offer' %></span>
          <div class="ocf-discount"><%= offer.discount %></div>
        </div>
        <div class="ocf-body">
          <h4 class="font-playfair"><%= offer.title %></h4>
          <p><%= offer.description %></p>
          <% if(offer.products && offer.products.length > 0) { %>
          <div class="ocf-products"><span>Applicable on: </span><%= offer.products.join(', ') %></div>
          <% } %>
          <div class="ocf-validity"><i class="fa-regular fa-clock me-1"></i> Valid till: <%= offer.validity %></div>
        </div>
        <div class="ocf-footer">
          <a href="/contact?subject=Avail Offer: <%= encodeURIComponent(offer.title) %>" class="btn-hero-primary w-100 justify-content-center d-flex" style="font-size:13.5px;">
            <i class="fa-solid fa-tag me-2"></i> Avail This Offer
          </a>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-5 fade-up mb-5">
    <i class="fa-solid fa-tag fa-4x mb-3" style="color:rgba(201,146,42,.25)"></i>
    <h4 class="font-playfair">No Active Offers Right Now</h4>
    <p class="text-muted">Check back soon or contact us to ask about bulk discounts.</p>
    <a href="/contact" class="btn-hero-primary mt-3 d-inline-flex"><i class="fa-solid fa-phone me-2"></i> Ask About Deals</a>
  </div>
  <% } %>

  <!-- Featured Product Deals -->
  <% if (locals.promoProducts && promoProducts.length > 0) { %>
    <div class="text-center mt-5 mb-4 fade-up">
      <span class="section-tag text-gold"><i class="fa-solid fa-gift me-1"></i> Hot Items</span>
      <h3 class="font-playfair mt-1 text-dark">Featured Product Deals</h3>
      <div class="snt-divider mx-auto mt-2"></div>
    </div>
    
    <div class="row g-4 justify-content-center">
      <% promoProducts.forEach(prod => { %>
        <div class="col-md-6 col-lg-4 fade-up">
          <div class="product-card-home" style="background:#fff;">
            <div class="product-img-wrap" style="height: 180px; position:relative; overflow:hidden;">
              <% if(prod.image) { %>
                <img src="<%= prod.image %>" class="w-100 h-100 object-fit-cover" alt="<%= prod.name %>">
                <div class="position-absolute start-0 top-0 w-100 h-100" style="background: rgba(0,0,0,0.15);"></div>
              <% } else { %>
                <i class="fa-regular fa-image fa-3x text-muted opacity-25"></i>
              <% } %>
              <span class="badge bg-warning text-dark fw-bold position-absolute top-0 end-0 m-2 px-3 py-1.5 shadow-sm" style="font-size: 11px; border-radius: 20px;">
                <i class="fa-solid fa-gift me-1"></i> Promo Active
              </span>
            </div>
            <div class="product-card-body p-3">
              <span class="prod-cat" style="font-size:10px; font-weight:700; color:var(--gold-dark); text-transform:uppercase;"><%= prod.category %></span>
              <h6 class="prod-name fw-bold text-dark text-truncate mb-2" title="<%= prod.name %>" style="font-size:14px;"><%= prod.name %></h6>
              
              <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="fs-5 fw-bold text-success">Rs. <%= (prod.wholesalePrice || prod.dealerPrice || 0).toFixed(2) %></span>
                <span class="text-muted text-decoration-line-through small" style="font-size:12px;">Rs. <%= (prod.regularPrice || prod.price || 0).toFixed(2) %></span>
              </div>
            </div>
            <div class="product-card-footer p-3 border-top d-flex gap-2">
              <a href="/products/<%= prod._id %>" class="btn btn-outline-gold btn-sm w-50 py-1.5 justify-content-center" style="font-size: 12px;"><i class="fa-solid fa-circle-info me-1"></i> Details</a>
              <a href="https://wa.me/919771233843?text=Hello%20Shri%20Narayan%20Traders!%20I%20am%20inquiring%20about%20the%20promo%20deal%20for%20*<%= encodeURIComponent(prod.name) %>*%20listed%20for%20Rs.%20<%= prod.wholesalePrice || prod.dealerPrice || 0 %>." target="_blank" class="btn btn-success btn-sm w-50 py-1.5 justify-content-center d-flex align-items-center" style="font-size: 12px; border-radius: 8px;"><i class="fa-brands fa-whatsapp me-1"></i> Inquiry</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- CTA -->
<section class="py-5" style="background:var(--navy-grad);">
  <div class="container text-center fade-up">
    <h3 class="font-playfair text-white mb-2">Want a Custom Deal?</h3>
    <p style="color:rgba(255,255,255,.6);font-size:14px;" class="mb-4">Bulk orders, contractor rates, or dealer pricing — just ask us!</p>
    <a href="https://wa.me/<%= settings.whatsapp %>?text=Hello, I want to enquire about offers and bulk pricing." target="_blank" class="btn-hero-primary d-inline-flex"><i class="fa-brands fa-whatsapp me-2"></i> Chat on WhatsApp</a>
  </div>
</section>

<style>
.offer-card-full { 
  background: #fff;
  border-radius: 16px;
  overflow: visible;
  box-shadow: var(--shadow-md);
  border: 1px solid rgba(201,146,42,.12);
  height: 100%;
  display: flex;
  flex-direction: column;
  transition: all var(--dur) var(--ease);
  position: relative;
}
/* Perforated coupon cutouts on the sides */
.offer-card-full::before, .offer-card-full::after {
  content: '';
  position: absolute;
  top: 154px;
  width: 14px; height: 14px;
  border-radius: 50%;
  background: var(--cream); /* Matches soft warm cream body backdrop */
  border: 1px solid rgba(201,146,42,.12);
  z-index: 10;
}
.offer-card-full::before { left: -8px; border-left: none; }
.offer-card-full::after { right: -8px; border-right: none; }

.offer-card-full:hover { 
  transform: translateY(-6px);
  box-shadow: 0 15px 35px rgba(201, 146, 42, 0.12);
  border-color: rgba(201,146,42,.35);
}
.ocf-header { 
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-deep) 100%);
  padding: 1.75rem;
  position: relative;
  overflow: hidden;
  border-top-left-radius: 15px;
  border-top-right-radius: 15px;
  border-bottom: 2px dashed var(--cream); /* Perforated dividing dash */
}
.ocf-header::before { content:'';position:absolute;top:-30px;right:-30px;width:100px;height:100px;border-radius:50%;background:rgba(201,146,42,.1); }
.ocf-tag { display:inline-block;background:var(--gold-grad);color:var(--navy-deep);font-size:10.5px;font-weight:800;padding:4px 14px;border-radius:20px;margin-bottom:.6rem; }
.ocf-discount { font-family:'Playfair Display',serif;font-size:3rem;font-weight:800;color:var(--gold-light);line-height:1; }
.ocf-body { padding:2rem 1.5rem 1.5rem;flex:1; }
.ocf-body h4 { font-size:1.1rem;color:var(--navy);margin-bottom:.5rem; }
.ocf-body p  { font-size:13.5px;color:var(--text-muted);line-height:1.7;margin-bottom:.75rem; }
.ocf-products { font-size:12px;background:rgba(201,146,42,.07);border:1px solid rgba(201,146,42,.15);border-radius:7px;padding:6px 10px;color:var(--gold-dark);margin-bottom:.75rem; }
.ocf-validity { font-size:12px;color:var(--gold-dark);font-weight:600; }
.ocf-footer { padding:0 1.5rem 1.5rem; }
</style>

<!-- Countdown Timer Script -->
<script>
  const countdownTargetStr = "<%= locals.countdownTarget || '' %>";
  if (countdownTargetStr) {
    const targetDate = new Date(countdownTargetStr).getTime();
    
    function updateCountdown() {
      const now = new Date().getTime();
      const diff = targetDate - now;
      
      const daysEl = document.getElementById('timer-days');
      const hoursEl = document.getElementById('timer-hours');
      const minsEl = document.getElementById('timer-minutes');
      const secsEl = document.getElementById('timer-seconds');
      
      if (!daysEl || !hoursEl || !minsEl || !secsEl) return;
      
      if (diff <= 0) {
        daysEl.innerText = "00";
        hoursEl.innerText = "00";
        minsEl.innerText = "00";
        secsEl.innerText = "00";
        return;
      }
      
      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((diff % (1000 * 60)) / 1000);
      
      daysEl.innerText = String(d).padStart(2, '0');
      hoursEl.innerText = String(h).padStart(2, '0');
      minsEl.innerText = String(m).padStart(2, '0');
      secsEl.innerText = String(s).padStart(2, '0');
    }
    
    updateCountdown();
    setInterval(updateCountdown, 1000);
  }
</script>

<%- include('partials/footer') %>
