<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | Shri Narayan Traders' : 'Shri Narayan Traders | Premium Hardware, Furniture & Aluminium Works' %></title>
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Shri Narayan Traders – Premium Hardware Supplier, Furniture Manufacturer & Aluminium Fabrication Works based in Munger, Bihar.' %>">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#001f4d">

  <style>
    /* ── Root Design Tokens ── */
    :root {
      --navy:        #001f4d;
      --navy-deep:   #000f2b;
      --navy-mid:    #002d62;
      --gold:        #c9922a;
      --gold-light:  #e8b84b;
      --gold-dark:   #9b6f1a;
      --gold-grad:   linear-gradient(135deg, #d4af37 0%, #9b6f1a 100%);
      --navy-grad:   linear-gradient(135deg, #001f4d 0%, #000f2b 100%);
      --cream:       #fdf8f0;
      --surface:     #ffffff;
      --text-main:   #1e293b;
      --text-muted:  #64748b;
      --border:      rgba(201,146,42,0.2);
      --shadow-sm:   0 2px 8px rgba(0,15,43,0.08);
      --shadow-md:   0 6px 24px rgba(0,15,43,0.12);
      --shadow-lg:   0 16px 48px rgba(0,15,43,0.18);
      --radius:      10px;
      --radius-lg:   16px;
      --ease:        cubic-bezier(0.4,0,0.2,1);
      --dur:         0.25s;
    }

    /* ── Base Reset ── */
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Outfit', sans-serif;
      background-color: var(--cream);
      color: var(--text-main);
      overflow-x: hidden;
      line-height: 1.65;
    }
    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: var(--cream); }
    ::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 3px; }

    /* ── Page Loader ── */
    #snt-loader {
      position: fixed; inset: 0; z-index: 99999;
      background: var(--navy-deep);
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.25rem;
      transition: opacity 0.5s var(--ease), visibility 0.5s var(--ease);
    }
    #snt-loader.loaded { opacity: 0; visibility: hidden; }
    .loader-logo-box {
      display: flex; align-items: center; gap: 12px;
    }
    .loader-monogram {
      width: 52px; height: 52px;
      background: var(--gold-grad);
      color: var(--navy-deep);
      font-size: 20px; font-weight: 900;
      display: flex; align-items: center; justify-content: center;
      border-radius: 12px;
      box-shadow: 0 0 20px rgba(201,146,42,0.5);
    }
    .loader-brand { color: #fff; font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; }
    .loader-sub { color: var(--gold-light); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; }
    .loader-bar {
      width: 220px; height: 3px;
      background: rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden;
    }
    .loader-bar-fill {
      height: 100%;
      background: var(--gold-grad);
      border-radius: 2px;
      animation: loaderFill 1.4s var(--ease) forwards;
    }
    @keyframes loaderFill { from { width: 0 } to { width: 100% } }

    /* ── Top Utility Bar ── */
    .top-bar {
      background: var(--navy-deep);
      color: rgba(255,255,255,0.65);
      font-size: 12px;
      padding: 6px 0;
      border-bottom: 1px solid rgba(201,146,42,0.15);
    }
    .top-bar a { color: rgba(255,255,255,0.65); transition: color var(--dur) var(--ease); }
    .top-bar a:hover { color: var(--gold-light); }
    .top-bar .announcement {
      background: linear-gradient(90deg, var(--gold-dark), var(--gold));
      color: var(--navy-deep);
      padding: 2px 10px; border-radius: 30px;
      font-weight: 700; font-size: 11px;
      animation: pulse-badge 2s ease infinite;
    }
    @keyframes pulse-badge {
      0%,100% { box-shadow: 0 0 0 0 rgba(201,146,42,0.4); }
      50%      { box-shadow: 0 0 0 6px rgba(201,146,42,0); }
    }

    /* ── Navbar ── */
    .site-navbar {
      background: var(--navy-grad);
      border-bottom: 2.5px solid var(--gold);
      box-shadow: var(--shadow-md);
      padding: 0;
      position: sticky; top: 0; z-index: 1030;
      transition: box-shadow var(--dur) var(--ease);
    }
    .site-navbar.scrolled { box-shadow: 0 8px 32px rgba(0,0,0,0.3); }
    .site-navbar .container { padding-top: 10px; padding-bottom: 10px; }

    /* Logo */
    .navbar-brand { display: flex; align-items: center; gap: 11px; text-decoration: none; flex-shrink: 0; }
    .logo-monogram {
      background: var(--gold-grad);
      color: var(--navy-deep);
      width: 46px; height: 46px;
      border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
      font-weight: 900; font-size: 17px; letter-spacing: 0.5px;
      box-shadow: 0 0 12px rgba(212,175,55,0.35);
      flex-shrink: 0;
      transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
    }
    .navbar-brand:hover .logo-monogram {
      transform: scale(1.05);
      box-shadow: 0 0 20px rgba(212,175,55,0.6);
    }
    .logo-text { display: flex; flex-direction: column; line-height: 1.15; }
    .logo-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.05rem; font-weight: 700;
      color: #fff; letter-spacing: 0.3px;
    }
    .logo-sub {
      font-size: 9.5px; font-weight: 600;
      color: var(--gold-light);
      text-transform: uppercase; letter-spacing: 2px;
    }

    /* Nav Links */
    .navbar-nav .nav-link {
      color: rgba(255,255,255,0.82) !important;
      font-size: 13.5px; font-weight: 500;
      padding: 7px 11px !important;
      border-radius: 7px;
      transition: all var(--dur) var(--ease);
      position: relative;
    }
    .navbar-nav .nav-link::after {
      content: '';
      position: absolute; bottom: 2px; left: 11px; right: 11px;
      height: 2px;
      background: var(--gold-light);
      border-radius: 1px;
      transform: scaleX(0);
      transition: transform var(--dur) var(--ease);
    }
    .navbar-nav .nav-link:hover { color: var(--gold-light) !important; background: rgba(255,255,255,0.06); }
    .navbar-nav .nav-link:hover::after,
    .navbar-nav .nav-link.active-link::after { transform: scaleX(1); }
    .navbar-nav .nav-link.active-link { color: var(--gold-light) !important; font-weight: 600; }

    /* Dropdown */
    .navbar-nav .dropdown-menu {
      background: var(--navy-deep);
      border: 1px solid rgba(201,146,42,0.25);
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
      padding: 6px;
      min-width: 180px;
    }
    .navbar-nav .dropdown-item {
      color: rgba(255,255,255,0.75);
      font-size: 13px;
      padding: 8px 14px;
      border-radius: 6px;
      transition: all var(--dur) var(--ease);
    }
    .navbar-nav .dropdown-item:hover { background: rgba(201,146,42,0.12); color: var(--gold-light); }
    .navbar-nav .dropdown-divider { border-color: rgba(255,255,255,0.1); }

    /* Quote button */
    .btn-quote {
      background: var(--gold-grad);
      color: var(--navy-deep) !important;
      font-weight: 700; font-size: 13px;
      padding: 8px 18px;
      border-radius: 30px; border: none;
      transition: all var(--dur) var(--ease);
      white-space: nowrap;
    }
    .btn-quote:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(201,146,42,0.45); }

    /* Toggler */
    .navbar-toggler {
      border: 1.5px solid rgba(201,146,42,0.5);
      border-radius: 8px; padding: 6px 10px;
      color: var(--gold-light);
    }
    .navbar-toggler:focus { box-shadow: 0 0 0 3px rgba(201,146,42,0.25); }

    /* Offcanvas */
    .offcanvas {
      background: var(--navy-grad) !important;
      border-left: 2px solid var(--gold) !important;
      max-width: 290px;
    }
    .offcanvas-header { border-bottom: 1px solid rgba(255,255,255,0.08); }
    .offcanvas-title { font-family: 'Playfair Display', serif; color: var(--gold-light) !important; font-size: 1.1rem; }
    .offcanvas .nav-link { padding: 10px 16px !important; border-radius: 8px; margin-bottom: 2px; }

    /* Google Translate */
    .goog-te-banner-frame.skiptranslate { display: none !important; }
    body { top: 0px !important; }
    .goog-te-gadget { font-family: 'Outfit', sans-serif !important; color: transparent !important; }
    .goog-te-gadget .goog-te-combo {
      padding: 5px 10px; border-radius: 6px;
      border: 1px solid var(--gold);
      background: rgba(255,255,255,0.05);
      color: var(--gold-light);
      font-size: 12px; font-weight: 600;
    }

    /* ── Global Utilities ── */
    .font-playfair { font-family: 'Playfair Display', serif; }
    .text-gold { color: var(--gold-light) !important; }
    .bg-gold-gradient { background: var(--gold-grad); }
    .bg-navy { background: var(--navy-grad); }
    .snt-divider {
      height: 3px; width: 55px;
      background: var(--gold-grad);
      border-radius: 2px;
    }
    .section-tag {
      font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--gold);
      display: inline-block; margin-bottom: 0.4rem;
    }

    /* Fade-up animation */
    .fade-up {
      opacity: 0; transform: translateY(28px);
      transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    }
    .fade-up.visible { opacity: 1; transform: translateY(0); }
    .fade-up-d1 { transition-delay: 0.1s; }
    .fade-up-d2 { transition-delay: 0.2s; }
    .fade-up-d3 { transition-delay: 0.3s; }
    .fade-up-d4 { transition-delay: 0.4s; }

    /* Responsive top-bar */
    @media (max-width: 768px) {
      .top-bar .top-bar-contact { display: none; }
      .logo-monogram { width: 40px; height: 40px; font-size: 15px; }
      .logo-name { font-size: 0.95rem; }
    }
  </style>
  <% if (typeof googleClientId !== 'undefined' && googleClientId) { %>
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <% } %>
</head>
<body>

<!-- Page Loader -->
<div id="snt-loader">
  <div class="loader-logo-box">
    <img src="/images/logo/snt-dark.png" alt="SNT" class="loader-logo-img" style="height: 52px; object-fit: contain; border-radius: 12px; background: #fff; padding: 3px; box-shadow: 0 0 20px rgba(201,146,42,0.5); margin-right: 8px;">
    <div>
      <div class="loader-brand">Shri Narayan Traders</div>
      <div class="loader-sub">Hardware · Furniture · Aluminium</div>
    </div>
  </div>
  <div class="loader-bar"><div class="loader-bar-fill"></div></div>
</div>

<!-- Top Utility Bar -->
<div class="top-bar d-none d-md-block">
  <div class="container d-flex justify-content-between align-items-center">
    <div class="top-bar-contact d-flex align-items-center gap-3">
      <a href="tel:<%= settings.phone.split(',')[0].trim() %>"><i class="fa-solid fa-phone fa-xs text-warning me-1"></i><%= settings.phone %></a>
      <a href="mailto:<%= settings.email %>"><i class="fa-solid fa-envelope fa-xs text-warning me-1"></i><%= settings.email %></a>
    </div>
    <div class="d-flex align-items-center gap-3">
      <span class="announcement"><i class="fa-solid fa-truck fa-xs me-1"></i><%= settings.announcementBar %></span>
      <span style="font-size:11px"><i class="fa-regular fa-clock fa-xs text-warning me-1"></i> Mon–Sat 9AM–8PM</span>
    </div>
  </div>
</div>

<!-- Navbar -->
<nav class="site-navbar navbar navbar-expand-lg navbar-dark" id="siteNavbar">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" href="/">
      <img src="/images/logo/snt-dark.png" alt="SNT" class="logo-brand-img" style="height: 44px; object-fit: contain; margin-right: 12px; border-radius: 8px; background: #fff; padding: 2px;">
      <div class="logo-text">
        <span class="logo-name"><%= settings.businessName %></span>
        <span class="logo-sub"><%= settings.heroBannerText %></span>
      </div>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
      <i class="fa-solid fa-bars"></i>
    </button>

    <!-- Desktop Nav -->
    <div class="collapse navbar-collapse justify-content-end" id="desktopNav">
      <ul class="navbar-nav align-items-center gap-1 me-3">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
        <li class="nav-item"><a class="nav-link" href="/services">Services</a></li>
        <li class="nav-item"><a class="nav-link" href="/products">Products</a></li>
        <li class="nav-item"><a class="nav-link" href="/gallery">Gallery</a></li>
        <li class="nav-item"><a class="nav-link" href="/offers"><i class="fa-solid fa-tag fa-xs me-1"></i>Offers</a></li>
        <li class="nav-item"><a class="nav-link" href="/track">Track Order</a></li>
        
        <% if (locals.user) { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle text-warning" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
            <% if (user.picture) { %>
              <img src="<%= user.picture %>" alt="User Photo" class="rounded-circle me-1 border border-warning" style="width: 22px; height: 22px; object-fit: cover; vertical-align: middle;">
            <% } else { %>
              <i class="fa-solid fa-circle-user me-1"></i>
            <% } %>
            <%= user.username %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end bg-dark border-gold">
            <% if (['admin', 'super-admin', 'manager', 'sales'].includes(user.role)) { %>
              <li><a class="dropdown-item text-light" href="/admin/dashboard"><i class="fa-solid fa-gauge me-1"></i> Admin Panel</a></li>
            <% } else { %>
              <li><a class="dropdown-item text-light" href="/profile"><i class="fa-solid fa-user me-1"></i> My Profile</a></li>
              <li><a class="dropdown-item text-light" href="/orders/my"><i class="fa-solid fa-boxes-stacked me-1"></i> My Orders</a></li>
              <li><a class="dropdown-item text-light" href="/payment"><i class="fa-solid fa-credit-card me-1"></i> Make Payment</a></li>
            <% } %>
            <li><hr class="dropdown-divider border-secondary text-light"></li>
            <li><a class="dropdown-item text-danger" href="/api/auth/logout"><i class="fa-solid fa-sign-out-alt me-1"></i> Logout</a></li>
          </ul>
        </li>
        <% } else { %>
        <li class="nav-item">
          <a class="nav-link btn btn-outline-warning text-warning px-3 py-1 ms-lg-2" href="/login">
            <i class="fa-solid fa-right-to-bracket me-1"></i> Login
          </a>
        </li>
        <% } %>
      </ul>
      <a href="/contact?subject=Request%20Quote" class="btn-quote"><i class="fa-solid fa-file-invoice-dollar me-1"></i> Get Quote</a>
    </div>
  </div>
</nav>

<!-- Mobile Offcanvas Menu -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="mobileMenu">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title"><i class="fa-solid fa-compass me-2"></i>Navigation</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body">
    <ul class="navbar-nav gap-1">
      <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/"><i class="fa-solid fa-house me-2 text-warning"></i>Home</a></li>
      <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/about"><i class="fa-solid fa-circle-info me-2 text-warning"></i>About Us</a></li>
      <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/services"><i class="fa-solid fa-screwdriver-wrench me-2 text-warning"></i>Services</a></li>
      <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/products"><i class="fa-solid fa-boxes-stacked me-2 text-warning"></i>Products</a></li>
      <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/gallery"><i class="fa-solid fa-images me-2 text-warning"></i>Gallery</a></li>
      <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/offers"><i class="fa-solid fa-tag me-2 text-warning"></i>Offers</a></li>
      <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/track"><i class="fa-solid fa-location-crosshairs me-2 text-warning"></i>Track Order</a></li>
      <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/contact"><i class="fa-solid fa-envelope me-2 text-warning"></i>Contact</a></li>
      
      <% if (locals.user) { %>
      <hr style="border-color:rgba(255,255,255,0.1)">
      <% if (['admin', 'super-admin', 'manager', 'sales'].includes(user.role)) { %>
        <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/admin/dashboard"><i class="fa-solid fa-chart-line me-2 text-warning"></i>Dashboard</a></li>
      <% } else { %>
        <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/profile"><i class="fa-solid fa-user me-2 text-warning"></i>My Profile</a></li>
        <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/orders/my"><i class="fa-solid fa-boxes-stacked me-2 text-warning"></i>My Orders</a></li>
        <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/payment"><i class="fa-solid fa-credit-card me-2 text-warning"></i>Make Payment</a></li>
      <% } %>
      <li data-bs-dismiss="offcanvas"><a class="nav-link text-danger" href="/api/auth/logout"><i class="fa-solid fa-sign-out-alt me-2"></i>Logout</a></li>
      <% } else { %>
      <li data-bs-dismiss="offcanvas"><a class="nav-link" href="/login"><i class="fa-solid fa-right-to-bracket me-2 text-warning"></i>Customer Login</a></li>
      <% } %>
    </ul>
    <a href="/contact?subject=Request%20Quote" class="btn-quote d-block text-center mt-3" data-bs-dismiss="offcanvas">
      <i class="fa-solid fa-file-invoice-dollar me-1"></i> Request a Quote
    </a>
  </div>
</div>

<script>
  // Loader hide
  window.addEventListener('load', () => {
    setTimeout(() => document.getElementById('snt-loader').classList.add('loaded'), 700);
  });
  // Navbar scroll effect
  window.addEventListener('scroll', () => {
    document.getElementById('siteNavbar').classList.toggle('scrolled', window.scrollY > 40);
  });
  // Active nav link
  const path = window.location.pathname;
  document.querySelectorAll('.nav-link').forEach(link => {
    const href = link.getAttribute('href');
    if (href && href !== '#' && !link.classList.contains('dropdown-toggle')) {
      if (path === href || (href !== '/' && path.startsWith(href))) {
        link.classList.add('active-link');
      }
    }
  });
  // Fade-up observer
  const fadeObs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); fadeObs.unobserve(e.target); } });
  }, { threshold: 0.1 });
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.fade-up').forEach(el => fadeObs.observe(el));
  });
</script>
