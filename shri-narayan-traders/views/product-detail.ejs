<%- include('partials/header') %>

<div class="container py-5">
  <!-- Breadcrumbs -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/products">Products</a></li>
      <li class="breadcrumb-item active" aria-current="page"><%= product.name %></li>
    </ol>
  </nav>

  <div class="row g-5">
    <!-- Image Column -->
    <div class="col-md-6">
      <div class="bg-white p-4 rounded shadow-sm border text-center position-relative overflow-hidden" style="min-height: 400px; display: flex; align-items: center; justify-content: center;">
        <% if (product.image) { %>
          <img src="<%= product.image %>" class="img-fluid object-fit-contain w-100" style="max-height: 450px;" alt="<%= product.name %>">
        <% } else { %>
          <div class="text-muted py-5">
            <i class="fa-regular fa-image display-1 mb-3"></i>
            <h4>No Image Available</h4>
          </div>
        <% } %>
        <span class="badge position-absolute top-4 start-4 bg-secondary text-uppercase fs-6 px-3 py-2"><%= product.category %></span>
      </div>
    </div>
    
    <!-- details Column -->
    <div class="col-md-6">
      <div class="bg-white p-4 p-md-5 rounded shadow-sm border h-100 d-flex flex-column justify-content-between">
        <div>
          <!-- Title & Stock Status -->
          <div class="d-flex justify-content-between align-items-start mb-3">
            <h1 class="fw-bold text-dark font-playfair mb-0"><%= product.name %></h1>
          </div>
          
          <div class="mb-4">
            <% if (product.stock > 0) { %>
              <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fs-6"><i class="fa-solid fa-circle-check me-1"></i> In Stock (<%= product.stock %> units available)</span>
            <% } else { %>
              <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 fs-6"><i class="fa-solid fa-triangle-exclamation me-1"></i> Out of Stock</span>
            <% } %>
            
            <% if (product.stock <= product.lowStockThreshold && product.stock > 0) { %>
              <span class="badge bg-warning text-dark px-3 py-2 fs-6 ms-2"><i class="fa-solid fa-circle-exclamation me-1"></i> Low Stock Alert</span>
            <% } %>
          </div>
          
          <!-- Pricing -->
          <div class="bg-light p-3 rounded mb-4 d-flex justify-content-between align-items-center">
            <div>
              <span class="text-muted d-block small fw-bold">RETAIL PRICE</span>
              <span class="text-primary fw-bold display-6">Rs. <%= (product.regularPrice || product.price || 0).toFixed(2) %></span>
            </div>
            <% if (locals.user && user.role === 'dealer') { %>
              <div class="text-end border-start ps-4">
                <span class="text-muted d-block small fw-bold text-uppercase text-warning">Wholesale Price</span>
                <span class="text-success fw-bold display-6">Rs. <%= (product.wholesalePrice || product.dealerPrice || 0).toFixed(2) %></span>
              </div>
            <% } %>
          </div>
          
          <!-- Description -->
          <h5 class="fw-bold text-dark mb-2">Description</h5>
          <p class="text-secondary mb-4 leading-relaxed"><%= product.description || 'No description provided by seller.' %></p>
          
          <!-- Technical Specifications -->
          <% if (product.specifications) { %>
            <h5 class="fw-bold text-dark mb-2">Specifications</h5>
            <div class="table-responsive mb-4">
              <table class="table table-bordered table-striped table-sm">
                <tbody>
                  <% product.specifications.split(',').forEach(spec => { %>
                    <% const parts = spec.split(':'); %>
                    <% if (parts.length >= 2) { %>
                      <tr>
                        <td class="fw-bold text-secondary bg-light text-capitalize" style="width: 30%;"><%= parts[0].trim() %></td>
                        <td class="text-dark"><%= parts.slice(1).join(':').trim() %></td>
                      </tr>
                    <% } else { %>
                      <tr>
                        <td colspan="2" class="text-dark"><%= spec.trim() %></td>
                      </tr>
                    <% } %>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
          
          <!-- Dynamic Custom Size & Price Estimator Widget (For Doors, Windows, and Custom Furniture) -->
          <% if (['furniture', 'office furniture', 'aluminium doors', 'aluminium windows', 'doors', 'windows'].includes(product.category.trim().toLowerCase())) { %>
            <div class="card border-0 shadow-sm rounded-4 p-4 mt-4" style="background: linear-gradient(135deg, var(--navy-deep) 0%, #001533 100%); border: 1.5px solid var(--gold) !important; position:relative; overflow:hidden;">
              <div style="position:absolute; top:-15px; right:-15px; font-size: 5rem; opacity: 0.05; color: #fff; pointer-events: none;"><i class="fa-solid fa-calculator"></i></div>
              <h5 class="text-warning fw-bold mb-1 font-playfair"><i class="fa-solid fa-ruler-combined me-2"></i> Custom Size &amp; Price Estimator</h5>
              <p class="text-white-50 small mb-3" style="font-size:11.5px;">Input your dimensions to calculate custom fabrication price.</p>
              
              <div class="row g-2 text-white">
                <div class="col-6">
                  <label class="form-label text-warning-emphasis small fw-bold mb-1" style="font-size:11px; letter-spacing:0.5px; text-transform:uppercase;">Width (Feet)</label>
                  <input type="number" id="calcWidth" class="form-control bg-dark border-secondary text-white fw-bold text-center" value="3.0" min="1" max="25" step="0.5" oninput="calculateEstimates()">
                </div>
                <div class="col-6">
                  <label class="form-label text-warning-emphasis small fw-bold mb-1" style="font-size:11px; letter-spacing:0.5px; text-transform:uppercase;">Height (Feet)</label>
                  <input type="number" id="calcHeight" class="form-control bg-dark border-secondary text-white fw-bold text-center" value="7.0" min="1" max="25" step="0.5" oninput="calculateEstimates()">
                </div>
                
                <div class="col-12 mt-2">
                  <label class="form-label text-warning-emphasis small fw-bold mb-1" style="font-size:11px; letter-spacing:0.5px; text-transform:uppercase;">Material / Frame Grade</label>
                  <select id="calcMaterial" class="form-select bg-dark border-secondary text-white small" onchange="calculateEstimates()" style="font-size:12.5px;">
                    <option value="1.0" selected>Standard Grade (Powder Coated / Local Timber)</option>
                    <option value="1.25">Premium Grade (Anodized Frame / Hardwood Ply)</option>
                    <option value="1.5">Elite Grade (Double Glazed Soundproof / Teak Wood)</option>
                  </select>
                </div>
              </div>
              
              <div class="d-flex align-items-center justify-content-between border-top border-secondary border-opacity-30 mt-3 pt-3 text-white">
                <div>
                  <span class="text-white-50 d-block small" style="font-size:10px; letter-spacing:0.5px; text-transform:uppercase;">Estimated Area</span>
                  <span class="fw-bold fs-5 text-warning"><span id="estArea">21.0</span> Sq. Ft.</span>
                </div>
                <div class="text-end">
                  <span class="text-white-50 d-block small" style="font-size:10px; letter-spacing:0.5px; text-transform:uppercase;">Estimated Price</span>
                  <span class="fw-bold fs-4 text-success">Rs. <span id="estPrice">2,100</span></span>
                </div>
              </div>
              
              <div class="mt-3">
                <a href="#" id="waEstimateBtn" target="_blank" class="btn btn-success w-100 py-2.5 fw-bold d-flex align-items-center justify-content-center" style="font-size: 13px; border-radius: 8px;">
                  <i class="fa-brands fa-whatsapp me-2 fs-5"></i> Send Custom Size Inquiry
                </a>
              </div>
            </div>
          <% } %>
        </div>
        
        <!-- Actions & Shipping Info -->
        <div class="border-top pt-4">
          <div class="d-flex align-items-center mb-3 text-secondary" style="font-size: 13px;">
            <i class="fa-solid fa-truck-ramp-box text-warning me-2 fs-5"></i>
            <span>🚚 **Delivery Details:** All India Doorstep Shipping. Secure wooden/bubble wrap packaging.</span>
          </div>
          
          <div class="d-grid gap-2">
            <a href="https://wa.me/919771233843?text=Hello%20Shri%20Narayan%20Traders!%20I%20am%20interested%20in%20inquiring%20about%20your%20product%20*<%= encodeURIComponent(product.name) %>*%20(Price:%20Rs.%20<%= (product.regularPrice || product.price || 0).toFixed(2) %>)." target="_blank" class="btn btn-success py-2.5 fw-bold btn-lg">
              <i class="fa-brands fa-whatsapp me-2 fs-5"></i> Inquiry on WhatsApp
            </a>
            <a href="/products" class="btn btn-outline-dark py-2.5 fw-bold btn-sm">
              <i class="fa-solid fa-arrow-left me-1"></i> Back to Catalog
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Related Products Section -->
  <% if (relatedProducts && relatedProducts.length > 0) { %>
    <div class="mt-5 pt-4 border-top">
      <h3 class="fw-bold text-dark font-playfair mb-4">Related Products</h3>
      <div class="row g-4">
        <% relatedProducts.forEach(prod => { %>
          <div class="col-md-4 col-sm-6">
            <div class="card product-card border-0 shadow-sm h-100 overflow-hidden">
              <div class="product-img-wrapper position-relative text-center bg-white" style="height: 180px; display: flex; align-items: center; justify-content: center;">
                <% if (prod.image) { %>
                  <img src="<%= prod.image %>" class="card-img-top object-fit-contain p-2 w-100 h-100" alt="<%= prod.name %>">
                <% } else { %>
                  <div class="w-100 h-100 bg-light d-flex flex-column align-items-center justify-content-center text-muted">
                    <i class="fa-regular fa-image fs-3 mb-2"></i>
                    <small>No Image Available</small>
                  </div>
                <% } %>
                <span class="badge position-absolute top-3 start-3 <%= prod.stock > 0 ? 'bg-success' : 'bg-danger' %>">
                  <%= prod.stock > 0 ? 'In Stock' : 'Out of Stock' %>
                </span>
              </div>
              <div class="card-body d-flex flex-column">
                <h6 class="card-title fw-bold text-dark text-truncate mb-2"><%= prod.name %></h6>
                <div class="mt-auto">
                  <span class="text-primary fw-bold d-block mb-3">Rs. <%= (prod.regularPrice || prod.price || 0).toFixed(2) %></span>
                  <div class="d-grid gap-2">
                    <a href="/products/<%= prod._id %>" class="btn btn-dark btn-sm fw-bold">View Details</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

<!-- Client-side Price Estimation Engine -->
<script>
function calculateEstimates() {
  const wInput = document.getElementById('calcWidth');
  const hInput = document.getElementById('calcHeight');
  if (!wInput || !hInput) return;
  
  const w = parseFloat(wInput.value) || 0;
  const h = parseFloat(hInput.value) || 0;
  const area = w * h;
  
  document.getElementById('estArea').innerText = area.toFixed(1);
  
  const basePrice = <%= product.regularPrice || product.price || 0 %>;
  // Standard doors average 3 ft x 7 ft = 21 sq ft. Baseline rate per sq ft is price / 21
  const ratePerSqFt = basePrice > 0 ? (basePrice / 21) : 130; 
  
  const matSelect = document.getElementById('calcMaterial');
  const multiplier = matSelect ? parseFloat(matSelect.value) : 1.0;
  
  const estPrice = Math.round(area * ratePerSqFt * multiplier);
  document.getElementById('estPrice').innerText = estPrice.toLocaleString('en-IN');
  
  const waBtn = document.getElementById('waEstimateBtn');
  if (waBtn) {
    const productName = "<%= product.name %>";
    const msg = `Hello Shri Narayan Traders! I want to enquire about custom fabrication for:\n\n*Product:* ${productName}\n*Dimensions:* ${w} ft (Width) x ${h} ft (Height)\n*Total Area:* ${area.toFixed(1)} Sq. Ft.\n*Grade:* ${matSelect ? matSelect.options[matSelect.selectedIndex].text : 'Standard'}\n*Estimated Price:* Rs. ${estPrice.toLocaleString('en-IN')}\n\nPlease let me know the availability and final delivery duration.`;
    waBtn.href = `https://wa.me/919771233843?text=${encodeURIComponent(msg)}`;
  }
}
document.addEventListener('DOMContentLoaded', () => {
  calculateEstimates();
});
</script>

<%- include('partials/footer') %>
