<%- include('partials/header') %>
<% pageTitle = "Products" %>

<section style="background:var(--navy-grad);border-bottom:3px solid var(--gold);padding:3.5rem 0;">
  <div class="container text-white fade-up">
    <div class="row align-items-center">
      <div class="col">
        <span class="section-tag text-warning">Our Catalog</span>
        <h1 class="font-playfair fw-bold mt-1 mb-1">All Products</h1>
        <p style="color:rgba(255,255,255,.65);font-size:14px">Browse our complete range of hardware, furniture, and aluminium products</p>
      </div>
      <div class="col-auto">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0" style="font-size:13px;"><li class="breadcrumb-item"><a href="/" class="text-warning text-decoration-none">Home</a></li><li class="breadcrumb-item active text-white-50">Products</li></ol></nav>
      </div>
    </div>
  </div>
</section>

<div class="container py-4">
  <div class="row g-3">
    <!-- Sidebar Filter -->
    <div class="col-lg-3 d-none d-lg-block">
      <div style="position:sticky;top:80px;">
        <div class="admin-card" style="border-radius:14px;overflow:hidden;">
          <div style="background:var(--navy-grad);padding:1rem 1.25rem;"><h6 style="color:#fff;margin:0;font-weight:700;"><i class="fa-solid fa-filter me-2 text-warning"></i>Filter Products</h6></div>
          <div style="padding:1.25rem;">
            <div class="mb-3"><label class="form-label-admin">Search</label><input type="text" id="filterSearch" class="form-control-admin" placeholder="Product name..." oninput="applyFilters()" /></div>
            <div class="mb-3"><label class="form-label-admin">Category</label>
              <div id="catFilters" style="display:flex;flex-direction:column;gap:.4rem;">
                <label class="filter-check"><input type="radio" name="cat" value="" checked onchange="applyFilters()"> All Categories</label>
                <% ['Hardware','Furniture','Office Furniture','Aluminium Doors','Aluminium Windows','Tools','Electrical','Plumbing'].forEach(c=>{ %>
                <label class="filter-check"><input type="radio" name="cat" value="<%= c %>" onchange="applyFilters()"> <%= c %></label>
                <% }) %>
              </div>
            </div>
            <div class="mb-3"><label class="form-label-admin">Sort By</label>
              <select id="sortBy" class="form-control-admin" onchange="applyFilters()">
                <option value="default">Default</option>
                <option value="price-asc">Price: Low to High</option>
                <option value="price-desc">Price: High to Low</option>
                <option value="name-asc">Name: A–Z</option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Products Grid -->
    <div class="col-lg-9">
      <!-- Mobile Filter Bar -->
      <div class="d-flex gap-2 mb-3 d-lg-none flex-wrap">
        <input type="text" class="form-control-admin flex-grow-1" placeholder="🔍 Search..." oninput="document.getElementById('filterSearch').value=this.value;applyFilters()" style="min-width:0;" />
        <select class="form-control-admin" style="max-width:150px;" onchange="document.getElementById('sortBy').value=this.value;applyFilters()">
          <option value="default">Sort</option><option value="price-asc">Price ↑</option><option value="price-desc">Price ↓</option>
        </select>
      </div>

      <div id="resultsCount" class="mb-3" style="font-size:13px;color:var(--text-muted);">Showing <%= products ? products.length : 0 %> products</div>

      <div class="row g-3" id="productsGrid">
        <% if(products && products.length > 0) { %>
        <% products.forEach((p, i) => { %>
        <div class="col-md-4 col-6 product-item fade-up"
          data-name="<%= p.name.toLowerCase() %>"
          data-cat="<%= p.category %>"
          data-price="<%= p.price %>"
          style="animation-delay:<%=i*0.04%>s">
          <div class="product-card-home">
            <div class="product-img-wrap">
              <% if(p.imageUrl) { %><img src="<%= p.imageUrl %>" alt="<%= p.name %>" loading="lazy" /><% } else { %><span class="product-emoji">📦</span><% } %>
              <% if(p.isNew) { %><span class="prod-badge new">New</span><% } %>
              <% if(p.discount) { %><span class="prod-badge sale">-<%= p.discount %>%</span><% } %>
            </div>
            <div class="product-card-body">
              <div class="prod-cat"><%= p.category %></div>
              <div class="prod-name"><%= p.name %></div>
              <div class="prod-price">₹<%= p.price.toLocaleString('en-IN') %><% if(p.originalPrice){ %><span class="prod-old">₹<%= p.originalPrice.toLocaleString('en-IN') %></span><% } %></div>
            </div>
            <div class="product-card-footer"><a href="/products/<%= p._id %>" class="btn-prod-view">View Details</a></div>
          </div>
        </div>
        <% }) %>
        <% } else { %>
        <div class="col-12 text-center py-5">
          <i class="fa-solid fa-boxes-stacked fa-3x mb-3 d-block" style="color:rgba(201,146,42,.2)"></i>
          <h5 class="font-playfair">No Products Yet</h5>
          <p class="text-muted">Products will appear here once added from the Admin panel.</p>
        </div>
        <% } %>
      </div>
      <div id="noResults" class="text-center py-5 d-none"><i class="fa-solid fa-magnifying-glass fa-3x mb-3 d-block" style="color:rgba(201,146,42,.2)"></i><h5>No products found</h5><p class="text-muted">Try a different search or category</p></div>
    </div>
  </div>
</div>

<style>
.filter-check { 
  display: flex;
  align-items: center;
  gap: .55rem;
  font-size: 13.5px;
  cursor: pointer;
  color: var(--text-muted);
  padding: 6px 8px;
  border-radius: 6px;
  transition: all var(--dur) var(--ease);
}
.filter-check:hover {
  background: rgba(201, 146, 42, 0.08);
  color: var(--navy);
}
.filter-check input { accent-color: var(--gold); }

/* Unified Product Card Layout */
.product-card-home { 
  background: #fff;
  border-radius: 14px;
  border: 1px solid rgba(201,146,42,.1);
  overflow: hidden;
  height: 100%;
  display: flex;
  flex-direction: column;
  transition: all var(--dur) var(--ease);
  position: relative;
}
.product-card-home::before {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 100%; height: 3.5px;
  background: var(--gold-grad);
  opacity: 0;
  transition: opacity var(--dur) var(--ease);
  z-index: 5;
}
.product-card-home:hover { 
  transform: translateY(-7px);
  box-shadow: 0 15px 35px rgba(0, 31, 77, 0.12);
  border-color: rgba(201,146,42,0.22);
}
.product-card-home:hover::before {
  opacity: 1;
}
.product-img-wrap { 
  position: relative;
  aspect-ratio: 4/3;
  background: var(--cream);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.product-img-wrap img { 
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s var(--ease);
}
.product-card-home:hover .product-img-wrap img {
  transform: scale(1.08);
}
.product-emoji { font-size:3rem; }
.prod-badge { position:absolute;top:.6rem;left:.6rem;font-size:10px;font-weight:700;padding:3px 8px;border-radius:20px;z-index:2; }
.prod-badge.new  { background:rgba(22,163,74,.15);color:#16a34a;border:1px solid #16a34a;}
.prod-badge.sale { background:rgba(220,38,38,.12);color:#dc2626;border:1px solid #dc2626;}
.product-card-body { padding:.9rem 1rem .6rem;flex:1;}
.prod-cat { font-size:10px;font-weight:700;color:var(--gold-dark);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.3rem;}
.prod-name { font-size:.85rem;font-weight:600;color:var(--navy);line-height:1.4;margin-bottom:.5rem;}
.prod-price { font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--gold-dark);}
.prod-old { font-size:.78rem;color:var(--text-muted);text-decoration:line-through;margin-left:.25rem;font-family:'Outfit',sans-serif;font-weight:400;}
.product-card-footer { padding:.6rem 1rem 1rem;}
.btn-prod-view { 
  display: block;
  width: 100%;
  text-align: center;
  background: rgba(0,31,77,.06);
  color: var(--navy);
  border: 1.5px solid rgba(0,31,77,.12);
  border-radius: 8px;
  padding: 8px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  transition: all var(--dur) var(--ease);
}
.btn-prod-view:hover { 
  background: var(--navy-grad);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4px 12px rgba(0, 31, 77, 0.2);
}
</style>

<script>
function applyFilters() {
  const q = (document.getElementById('filterSearch').value||'').toLowerCase();
  const cat = document.querySelector('input[name="cat"]:checked')?.value||'';
  const sort = document.getElementById('sortBy').value;
  const items = Array.from(document.querySelectorAll('.product-item'));
  let visible = items.filter(el => {
    const matchQ = !q || el.dataset.name.includes(q);
    const matchC = !cat || (() => {
      const dbCat = (el.dataset.cat || '').trim().toLowerCase();
      const filterCat = cat.trim().toLowerCase();
      if (dbCat === filterCat) return true;
      if (dbCat.includes(filterCat) || filterCat.includes(dbCat)) return true;
      if (filterCat === 'furniture' && dbCat.includes('furniture')) return true;
      if (filterCat === 'office' && dbCat.includes('office')) return true;
      if (filterCat === 'doors' && dbCat.includes('doors')) return true;
      if (filterCat === 'windows' && dbCat.includes('windows')) return true;
      return false;
    })();
    return matchQ && matchC;
  });
  if (sort === 'price-asc') visible.sort((a,b)=>+a.dataset.price - +b.dataset.price);
  else if (sort === 'price-desc') visible.sort((a,b)=>+b.dataset.price - +a.dataset.price);
  else if (sort === 'name-asc') visible.sort((a,b)=>a.dataset.name.localeCompare(b.dataset.name));
  items.forEach(el=>el.style.display='none');
  visible.forEach(el=>el.style.display='');
  const grid = document.getElementById('productsGrid');
  visible.forEach(el=>grid.appendChild(el));
  document.getElementById('resultsCount').textContent = `Showing ${visible.length} product${visible.length!==1?'s':''}`;
  document.getElementById('noResults').classList.toggle('d-none', visible.length > 0);
}
// Pre-filter from URL param
const urlCat = new URLSearchParams(location.search).get('category');
if (urlCat) {
  const normalizedUrlCat = urlCat.trim().toLowerCase();
  const radio = Array.from(document.querySelectorAll('input[name="cat"]')).find(r => {
    const val = r.value.trim().toLowerCase();
    return val === normalizedUrlCat || 
           val.includes(normalizedUrlCat) || 
           normalizedUrlCat.includes(val) ||
           (normalizedUrlCat === 'furniture' && val.includes('furniture')) ||
           (normalizedUrlCat === 'office' && val.includes('office')) ||
           (normalizedUrlCat === 'doors' && val.includes('doors')) ||
           (normalizedUrlCat === 'windows' && val.includes('windows'));
  });
  if (radio) {
    radio.checked = true;
    applyFilters();
  }
}
</script>

<%- include('partials/footer') %>
