<%- include('partials/header') %>

<style>
  /* Premium Colors & Custom Variables */
  :root {
    --brand-navy: #0d1b2a;
    --brand-gold: #c5a880;
    --brand-gold-dark: #b39268;
    --card-glow-primary: rgba(13, 110, 253, 0.12);
    --card-glow-warning: rgba(255, 193, 7, 0.12);
    --card-glow-info: rgba(13, 202, 240, 0.12);
  }

  /* Smooth dynamic animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Hero Section styling */
  .services-hero {
    background: linear-gradient(135deg, #0d1b2a 0%, #1b263b 100%);
    position: relative;
    overflow: hidden;
    padding: 6rem 0;
  }
  
  .services-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(197, 168, 128, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .services-hero h1 {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    letter-spacing: -0.5px;
  }

  .services-hero p {
    animation: fadeInUp 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Premium Card Styles */
  .premium-service-card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    border-radius: 16px !important;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
    overflow: hidden;
  }

  .premium-service-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    transition: all 0.3s ease;
  }

  .card-primary::after { background: var(--bs-primary); }
  .card-warning::after { background: var(--bs-warning); }
  .card-info::after { background: var(--bs-info); }

  .premium-service-card:hover {
    transform: translateY(-8px);
    border-color: transparent !important;
  }

  .card-primary:hover {
    box-shadow: 0 20px 40px var(--card-glow-primary);
  }
  .card-warning:hover {
    box-shadow: 0 20px 40px var(--card-glow-warning);
  }
  .card-info:hover {
    box-shadow: 0 20px 40px var(--card-glow-info);
  }

  /* Icon Wrappers */
  .icon-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    margin-bottom: 1.5rem;
  }

  .card-primary .icon-wrapper {
    background: rgba(13, 110, 253, 0.08);
    color: var(--bs-primary);
  }
  .card-warning .icon-wrapper {
    background: rgba(255, 193, 7, 0.08);
    color: var(--bs-warning);
  }
  .card-info .icon-wrapper {
    background: rgba(13, 202, 240, 0.08);
    color: var(--bs-info);
  }

  .premium-service-card:hover .icon-wrapper {
    transform: scale(1.1) rotate(5deg);
  }

  /* Feature Lists */
  .feature-list li {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    color: #4a5568;
    transition: transform 0.2s ease;
  }

  .feature-list li:hover {
    transform: translateX(4px);
  }

  .feature-list i {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(25, 135, 84, 0.1);
    color: #198754;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    margin-right: 0.75rem;
    flex-shrink: 0;
  }

  /* Process Timeline */
  .process-step {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .step-number {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--brand-navy);
    color: var(--brand-gold);
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
    border: 3px solid #ffffff;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    font-size: 1.1rem;
    transition: all 0.3s ease;
  }

  .process-step:hover .step-number {
    background: var(--brand-gold);
    color: var(--brand-navy);
    transform: scale(1.08);
  }

  /* CTA Banner */
  .cta-banner {
    background: linear-gradient(135deg, #1b263b 0%, #0d1b2a 100%);
    border-radius: 20px;
    box-shadow: 0 15px 30px rgba(13, 27, 42, 0.15);
    position: relative;
    overflow: hidden;
  }

  .cta-banner::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -30%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(197, 168, 128, 0.05) 0%, transparent 70%);
    pointer-events: none;
  }
</style>

<!-- Services Hero Section -->
